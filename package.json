{
  "name": "rubberstamp",
  "version": "0.1.0",
  "description": "Find the functions your tests call but never check: hollows out each one and reports the ones no test notices.",
  "type": "module",
  "license": "MIT",
  "author": "Anime5hka",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "rubberstamp": "bin/rubberstamp.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [
    "testing",
    "mutation-testing",
    "extreme-mutation",
    "pseudo-tested",
    "test-quality",
    "ai-generated-tests",
    "node-test",
    "mocha"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anime5hka/rubberstamp.git"
  },
  "exports": {
    "./vitest": "./src/vitest.js",
    "./package.json": "./package.json"
  }
}
